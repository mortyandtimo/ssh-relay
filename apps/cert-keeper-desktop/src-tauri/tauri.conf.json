{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "证书管家",
  "version": "0.1.0",
  "identifier": "com.certkeeper.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "证书管家",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/icon-16.png",
      "icons/icon-32.png",
      "icons/icon-48.png",
      "icons/icon-64.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "wix": {
        "language": "zh-CN"
      }
    },
    "shortDescription": "证书管家 — SSL证书管理桌面应用",
    "longDescription": "A desktop application for managing SSL certificates: upload, auto-issue via Let's Encrypt, DNS check, and nginx integration."
  }
}
