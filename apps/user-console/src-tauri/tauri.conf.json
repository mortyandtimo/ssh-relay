{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "驻阡陌用户端",
  "version": "0.1.0",
  "identifier": "com.cloudrelay.user",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "驻阡陌用户端",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/icon-16.png",
      "icons/icon-32.png",
      "icons/icon-48.png",
      "icons/icon-64.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "wix": {
        "language": "zh-CN"
      }
    },
    "shortDescription": "驻阡陌用户端 — 网盘访问、图床批量上传与 P2P 直连入口",
    "longDescription": "A Windows desktop user console for Cloud Relay end users, focused on P2P-enabled drive access, bulk image uploads, and local client policy management."
  }
}
