[Unit]
Description=CertKeeper API Server
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cert-keeper
ExecStart=/opt/cert-keeper/cert-keeper-api
Restart=always
RestartSec=5
EnvironmentFile=-/etc/cloud-relay/cert-keeper/cert-keeper.env
Environment=CERT_KEEPER_PORT=7720
Environment=CERT_KEEPER_CERT_DIR=/etc/cloud-relay/cert-keeper/certs
Environment=CERT_KEEPER_NGINX_CONF_DIR=/etc/cloud-relay/cert-keeper/nginx
Environment=CERT_KEEPER_WEBROOT=/www/server/nginx/html
Environment=CERT_KEEPER_NGINX_BIN=/www/server/nginx/sbin/nginx
Environment=CERT_KEEPER_BOOTSTRAP_SECRET=%m

[Install]
WantedBy=multi-user.target
