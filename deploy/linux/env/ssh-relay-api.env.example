# SSH Relay API environment configuration
SSHR_LISTEN_ADDR=:7722
SSHR_DATABASE_URL=postgresql://cloud_relay:password@127.0.0.1:5432/cloud_relay?sslmode=disable
SSHR_DOMAIN=tunnel.example.com
SSHR_PORT_START=40000
SSHR_PORT_END=40999

# SMTP for offline alert emails
SSHR_SMTP_HOST=smtp.example.com
SSHR_SMTP_PORT=587
SSHR_SMTP_USERNAME=alerts@example.com
SSHR_SMTP_PASSWORD=your_password
SSHR_SMTP_FROM=alerts@example.com
