ET_NETWORK_NAME=cloud-relay
ET_NETWORK_SECRET=replace-with-a-strong-shared-secret
ET_HOSTNAME=service-node-01
ET_INSTANCE_NAME=cloud-relay-service-node-01
ET_DHCP=true
ET_NO_TUN=true
ET_RPC_PORTAL=127.0.0.1:15888
ET_LISTENERS=tcp://0.0.0.0:11010,udp://0.0.0.0:11010
ET_PEERS=tcp://easytier.manage.020309.top:11010
ET_CONSOLE_LOG_LEVEL=info
ET_FILE_LOG_LEVEL=info
ET_FILE_LOG_DIR=/var/log/cloud-relay-platform/easytier
