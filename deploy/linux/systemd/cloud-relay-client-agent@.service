[Unit]
Description=Cloud Relay Platform Client Agent (%i)
After=network-online.target
Wants=network-online.target
PartOf=cloud-relay-service-node@%i.target

[Service]
Type=simple
WorkingDirectory=/opt/cloud-relay-platform
EnvironmentFile=/etc/cloud-relay-platform/client-agent/%i.env
Environment=CLIENT_SERVICE_UNIT=cloud-relay-client-agent@%i.service
Environment=CLIENT_INSTANCE_PROFILE=%i
Environment=CLIENT_DEPLOYMENT_MODE=managed
ExecStart=/opt/cloud-relay-platform/bin/client-agent
Restart=always
RestartSec=5
User=relay
Group=relay
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
