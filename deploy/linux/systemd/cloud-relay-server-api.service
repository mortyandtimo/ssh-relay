[Unit]
Description=Cloud Relay Platform Server API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cloud-relay-platform
EnvironmentFile=/etc/cloud-relay-platform/server-api.env
ExecStart=/opt/cloud-relay-platform/bin/server-api
Restart=always
RestartSec=3
User=relay
Group=relay
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

